# =============================================================================
# Hamees Inventory Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL via Unix socket (production):
# DATABASE_URL="postgresql://hamees_user:YOUR_PASSWORD@/tailor_inventory?host=/var/run/postgresql&schema=public"
#
# Standard TCP connection (development):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tailor_inventory?schema=public"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-secret-key-min-32-chars"

# Your application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3009"

# Required in production behind a proxy (nginx / Cloudflare)
AUTH_TRUST_HOST=true

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── WhatsApp Business API (Optional) ─────────────────────────────────────────
# Leave blank to run in development mode (messages logged to console only).
# Obtain from https://developers.facebook.com/docs/whatsapp/cloud-api

WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_URL="https://graph.facebook.com/v17.0"
WHATSAPP_BUSINESS_ACCOUNT_ID=""
