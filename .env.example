# =============================================================================
# Hamees Inventory Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL via Unix socket (production):
# DATABASE_URL="postgresql://hamees_user:YOUR_PASSWORD@/tailor_inventory?host=/var/run/postgresql&schema=public"
#
# Standard TCP connection (development):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tailor_inventory?schema=public"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-secret-key-min-32-chars"

# Your application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3009"

# Required in production behind a proxy (nginx / Cloudflare)
AUTH_TRUST_HOST=true

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Localization defaults (optional) ─────────────────────────────────────────
# Fallbacks only: used when the database has no BusinessSettings row (e.g. after `db:seed`)
# or cannot be reached. A migrated database always has that row, so on a normal install the
# shop's values come from Admin Settings → Currency & Locale instead.
# NEXT_PUBLIC_* values are baked into the build: rebuild after changing them.
NEXT_PUBLIC_DEFAULT_BUSINESS_NAME="My Tailor Shop"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"          # ISO 4217 code, e.g. USD, GBP, AED
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"          # BCP 47 locale, e.g. en-US, en-GB
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata" # IANA time zone, e.g. Europe/London

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Database-backed integration tests only run when this points at a DISPOSABLE database.
# Never point it at production.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tailor_inventory_test"

# ── WhatsApp Business API (Optional) ─────────────────────────────────────────
# Leave blank to run in development mode (messages logged to console only).
# Obtain from https://developers.facebook.com/docs/whatsapp/cloud-api

WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_URL="https://graph.facebook.com/v17.0"
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ── Excel / VBA Integration ───────────────────────────────────────────────────
# Static API key used by the Excel VBA macro (hamees_orders_template.xlsm).
# Generate with: openssl rand -hex 32
# Set the same value in the Excel VBA module constant HAMEES_API_KEY.
EXCEL_API_KEY=""
